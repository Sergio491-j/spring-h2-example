# COMPILAMOS LA APLICACIÓN
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
COPY src ./src

# ESTE COMANDO SE EJECUTA AL CREAR LA IMÁGEN
RUN mvn clean package -DskipTests

# EJECUTAMOS LA APLICACIÓN YA TENIENDO EL .JAR EN /TARGET
FROM eclipse-temurin:21-jre
WORKDIR /app

# COPIAMOS EL .JAR GENERADO DE LA COMPILACIÓN ANTERIOR
COPY --from=build ./target/*.jar app.jar

EXPOSE 8080

# ESTE OTRO, A DIFERENCIA DE RUN. SE EJECUTA CUANDO EJECUTAS EL CONTENEDOR
ENTRYPOINT ["java", "-jar", "app.jar"]


